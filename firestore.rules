rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256;
    }

    function isValidPlan(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.ownerId is string &&
             data.ownerId == request.auth.uid &&
             data.yearlyGoal is string &&
             data.yearlyGoal.size() <= 1000;
    }

    // User profiles - strictly private to the user
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false; // Blanket user listing forbidden for PII security
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // User goal roadmaps - strictly private to the owner
    match /plans/{planId} {
      allow get: if isValidId(planId) && isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(planId) && isSignedIn() && request.resource.data.ownerId == request.auth.uid && isValidPlan(request.resource.data);
      allow update: if isValidId(planId) && isSignedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid && isValidPlan(request.resource.data);
      allow delete: if isValidId(planId) && isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
